{
  "platform": "linux",
  "arch": "x64",
  "node": "v22.22.0",
  "uid": 1000,
  "next": "16.4.3",
  "react": "19.3.0",
  "sharp": "0.35.5",
  "buildId": "MsT5DOwHWYPM9hqsSV0bO",
  "alertRoutes": [
    [
      "/(en)/app/ranking-alerts/page",
      "app/(en)/app/ranking-alerts/page.js"
    ]
  ],
  "prerenderedAlertRoute": {
    "routeType": "page",
    "response": "complete",
    "compute": "static",
    "htmlSize": 18150,
    "experimentalBypassFor": [
      {
        "type": "header",
        "key": "next-action"
      },
      {
        "type": "header",
        "key": "content-type",
        "value": "multipart/form-data;.*"
      }
    ],
    "initialRevalidateSeconds": false,
    "srcRoute": "/app/ranking-alerts",
    "dataRoute": "/app/ranking-alerts.rsc",
    "allowHeader": [
      "host",
      "x-matched-path",
      "x-prerender-revalidate",
      "x-prerender-revalidate-if-generated",
      "x-next-revalidated-tags",
      "x-next-revalidate-tag-token"
    ]
  },
  "absentDevelopmentPackages": {
    "vitest": true,
    "vite": true,
    "eslint": true,
    "eslint-config-next": true,
    "minimatch": true,
    "zod": true
  }
}
