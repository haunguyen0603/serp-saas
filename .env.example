# Local development only. Replace credentials and origins for deployment.
APP_ENV=development
APP_NAME=serp-saas
APP_VERSION=0.1.0
DEBUG=true
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
POSTGRES_DB=serp_saas
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/serp_saas
REDIS_URL=redis://redis:6379/0
CORS_ORIGINS=["http://localhost:3000"]
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_APP_ENV=development

# Authentication: public local-only placeholder; generate a random production secret.
JWT_SECRET_KEY=replace-with-a-long-random-secret-generated-locally
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
AUTH_COOKIE_NAME=serp_refresh_token
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax

# Rank checks. Provider selection is backend-only; users do not choose it.
SERP_ENABLED_PROVIDERS=serper,serpapi
SERP_PROVIDER_STRATEGY=priority
SERP_PROVIDER_PRIORITY=serper,serpapi
SERP_FIXED_PROVIDER=serper
SERP_MAX_PROVIDER_FALLBACKS=1
SERPER_API_KEY=
SERPER_BASE_URL=https://google.serper.dev/search
SERPER_REQUEST_BUDGET=
SERPAPI_API_KEY=
SERPAPI_BASE_URL=https://serpapi.com/search
SERPAPI_REQUEST_BUDGET=
SERP_REQUEST_TIMEOUT_SECONDS=10
SERP_DEFAULT_RESULT_LIMIT=10
SERP_MAX_CONCURRENT_REQUESTS=3
SERP_MANUAL_PROJECT_KEYWORD_LIMIT=25
