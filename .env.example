# Local development only. Replace credentials and origins for deployment.
APP_ENV=development
APP_NAME=serp-saas
APP_VERSION=0.1.0
DEBUG=true
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
POSTGRES_DB=serp_saas
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/serp_saas
REDIS_URL=redis://redis:6379/0
CORS_ORIGINS=["http://localhost:3000"]
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Authentication: public local-only placeholder; generate a random production secret.
JWT_SECRET_KEY=replace-with-a-long-random-secret-generated-locally
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
AUTH_COOKIE_NAME=serp_refresh_token
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax

# Rank checks. Provider selection is backend-only; users do not choose it.
SERP_ENABLED_PROVIDERS=serper,serpapi
SERP_PROVIDER_STRATEGY=priority
SERP_PROVIDER_PRIORITY=serper,serpapi
SERP_FIXED_PROVIDER=serper
SERP_MAX_PROVIDER_FALLBACKS=1
SERPER_API_KEY=
SERPER_BASE_URL=https://google.serper.dev/search
SERPER_REQUEST_BUDGET=
SERPAPI_API_KEY=
SERPAPI_BASE_URL=https://serpapi.com/search
SERPAPI_REQUEST_BUDGET=
SERP_REQUEST_TIMEOUT_SECONDS=10
SERP_DEFAULT_RESULT_LIMIT=10
SERP_MAX_CONCURRENT_REQUESTS=3
SERP_MANUAL_PROJECT_KEYWORD_LIMIT=25

# M5 durable asynchronous ranking (zero GCP cost locally)
TASK_QUEUE_PROVIDER=local
REPORT_STORAGE_ROOT=/var/lib/serp-saas/reports
REPORT_STORAGE_PROVIDER=local
REPORT_STORAGE_BUCKET=
REPORT_STORAGE_PREFIX=reports
REPORT_MAX_RANGE_DAYS=365
REPORT_MAX_CSV_ROWS=100000
REPORT_MAX_PDF_DETAIL_ROWS=1000
REPORT_ARTIFACT_RETENTION_DAYS=30
REPORT_MAX_CONCURRENT_PER_USER=2
REPORT_MAX_ACTIVE_SCHEDULES_PER_PROJECT=5
REPORT_JOB_MAX_ATTEMPTS=3
REPORT_JOB_LEASE_SECONDS=300
REPORT_EMAIL_PROVIDER=disabled
REPORT_EMAIL_FROM=
REPORT_EMAIL_ATTACHMENT_MAX_BYTES=5000000
REPORT_SMTP_HOST=
REPORT_SMTP_PORT=587
REPORT_SMTP_USERNAME=
REPORT_SMTP_PASSWORD=
REPORT_SMTP_STARTTLS=true
RANK_CHECK_BATCH_MAX_KEYWORDS=5000
RANK_CHECK_JOB_MAX_ATTEMPTS=5
RANK_CHECK_JOB_LEASE_SECONDS=300
GCP_PROJECT_ID=
GCP_LOCATION=
CLOUD_TASKS_QUEUE=rank-checks
CLOUD_TASKS_WORKER_URL=
CLOUD_TASKS_SERVICE_ACCOUNT_EMAIL=
SCHEDULER_SERVICE_ACCOUNT_EMAIL=
TASK_DISPATCH_MAX_PER_SECOND=2
TASK_MAX_CONCURRENT_DISPATCHES=2
TASK_MIN_BACKOFF_SECONDS=30
TASK_MAX_BACKOFF_SECONDS=300
TASK_MAX_RETRY_DURATION_SECONDS=3600
WORKER_DB_POOL_SIZE=2
WORKER_DB_MAX_OVERFLOW=0
